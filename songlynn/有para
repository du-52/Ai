# Pre-Processing for Classical ML
import re

def basic_clean(text):
    # 1. Remove HTML tags
    text = re.sub(r'<.*?>', ' ', text)

    # 2. Remove URLs
    text = re.sub(r'http\S+|www\S+', ' ', text)

    # 3. Remove special characters (keep letters, numbers, punctuation)
    text = re.sub(r"[^a-zA-Z0-9\s.,!?']", ' ', text)

    # 4. Normalize whitespace
    text = re.sub(r'\s+', ' ', text).strip()
    return text

X_train_cleaned = X_train.apply(basic_clean)
X_test_cleaned = X_test.apply(basic_clean)

