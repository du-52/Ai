# Function to load text files from directory
def load_texts_from_dir(directory_path):
    texts = []
    labels = []
    
    # Load positive reviews
    pos_path = Path(directory_path) / "pos"
    for file_path in pos_path.glob("*.txt"):
        with open(file_path, 'r', encoding='utf-8') as f:
            texts.append(f.read())
            labels.append(1)  # positive = 1
    
    # Load negative reviews
    neg_path = Path(directory_path) / "neg"
    for file_path in neg_path.glob("*.txt"):
        with open(file_path, 'r', encoding='utf-8') as f:
            texts.append(f.read())
            labels.append(0)  # negative = 0
    
    return texts, labels

