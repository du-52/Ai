import nltk
from nltk.corpus import stopwords
from nltk.stem import PorterStemmer, WordNetLemmatizer
from nltk.tokenize import word_tokenize

# Download resources (run once)
nltk.download("punkt")
nltk.download("stopwords")
nltk.download("wordnet")
nltk.download("punkt_tab")

stop_words = set(stopwords.words("english"))

# Words to keep in stop words
to_keep = ["no", "nor", "never", "not", "n't"]
for neg in to_keep:
    stop_words.discard(neg)

stemmer = PorterStemmer()
lemmatizer = WordNetLemmatizer()

# THE FUNCTION BELOW IS TO BE USED ONLY IF YOU ARE USING CLASSICAL ML
def classical_preprocess(text, use_stemming=True):
    # 1. Tokenization
    tokens = word_tokenize(text)

    # 2. Lowercasing
    tokens = [t.lower() for t in tokens]

    # 3. Stopword removal (keep "not")
    tokens = [t for t in tokens if t not in stop_words]

    # 4. Negation handling: "not good" → "not_good"
    processed_tokens = []
    skip = False
    for i in range(len(tokens)):
        if skip:
            skip = False
            continue
        if tokens[i] in to_keep and i+1 < len(tokens):
            processed_tokens.append("not_" + tokens[i+1])
            skip = True
        else:
            processed_tokens.append(tokens[i])

    # 5. Stemming or Lemmatization
    if use_stemming:
        processed_tokens = [stemmer.stem(t) for t in processed_tokens]
    else:
        processed_tokens = [lemmatizer.lemmatize(t) for t in processed_tokens]

    # Join back into a single string (for TF-IDF)
    return " ".join(processed_tokens)

